[Unit]
Description=Agent Coworking Space runtime backup
Documentation=https://github.com/GlennAyden/agent-coworking-space

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/agent-coworking-space
EnvironmentFile=-/home/ubuntu/agent-coworking-space/deploy/.env.production
ExecStart=/usr/bin/env bash -lc 'cd /home/ubuntu/agent-coworking-space && pnpm run backup:runtime'
NoNewPrivileges=true
PrivateTmp=true
