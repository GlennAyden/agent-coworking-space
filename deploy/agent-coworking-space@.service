[Unit]
Description=Agent Coworking Space service
Documentation=https://github.com/GlennAyden/agent-coworking-space
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/agent-coworking-space
EnvironmentFile=-/home/%i/agent-coworking-space/deploy/.env.production
ExecStartPre=/usr/bin/env bash -lc 'mkdir -p /home/%i/agent-coworking-space/logs'
ExecStart=/usr/bin/env bash -lc 'cd /home/%i/agent-coworking-space && pnpm run start:prod'
Restart=on-failure
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/home/%i/agent-coworking-space/logs/agent-coworking-space.log
StandardError=append:/home/%i/agent-coworking-space/logs/agent-coworking-space.err
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
